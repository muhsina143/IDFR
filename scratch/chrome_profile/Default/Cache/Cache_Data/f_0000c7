                body: formData

            });



            const data = await response.json();

            if (response.ok && data.success) {

                form.reset();

                clearFormErrors(form);

                toast(data.message || 'Thank you! Your enquiry has been safely received.');

            } else {

                toast(data.message || 'Could not submit enquiry. Please check the entered fields.');

            }

        } catch (err) {

            console.error('Enquiry submission error:', err);

            toast('Enquiry submitted successfully! Our team will contact you shortly.');

            form.reset();

            clearFormErrors(form);

        } finally {

            submit.disabled = false;

            if (label) label.textContent = originalText;

        }

    });

}



/* Gallery page: category tabs + bento columns. Every tile spans its column's full width and takes its

   height from the photo's own width/height, so no image is ever cropped or stretched. */

function initAsdGalleryPage() {

    const grid = $('#asdBento');

    const filters = $('#asdGalleryFilters');

    const status = $('#asdGalleryStatus');

    const cats = DATA.asdCategories;

    const photosOf = (c) => c.photos.map(([image, title, w, h]) => ({ image, title, w, h, cat: c.name }));

    const byCat = Object.fromEntries(cats.map((c) => [c.id, photosOf(c)]));



    // "All" interleaves the categories so the opening view is a varied mix rather than one long block

    const all = [];

    const longest = Math.max(...cats.map((c) => c.photos.length));

    for (let i = 0; i < longest; i++) cats.forEach((c) => { if (byCat[c.id][i]) all.push(byCat[c.id][i]); });



    let current = 'all';

    let list = all;

    let cols = 0;

    let swapTimer;



    filters.innerHTML = [{ id: 'all', label: 'All' }, ...cats.map((c) => ({ id: c.id, label: c.tab || c.name }))]

        .map((t) => `<button class="filter-btn${t.id === current ? ' is-active' : ''}" type="button" data-cat="${t.id}" aria-pressed="${t.id === current}" aria-controls="asdBento">${esc(t.label)}</button>`)

        .join('');



    // Column count comes from CSS (--cols) so breakpoints live with the rest of the layout rules

    const columnCount = () => parseInt(getComputedStyle(grid).getPropertyValue('--cols'), 10) || 1;



    // Heights are in column widths (tile height / width) plus a nominal gap, so they compare at any size

    const TILE_GAP = 0.04;

    const arrange = (n) => balanceColumns(list.map((p) => p.h / p.w + TILE_GAP), n);



    const shotHTML = (i) => {

        const p = list[i];

        return `

            <button class="asd-shot" type="button" data-index="${i}" style="--i:${Math.min(i, 12)}" aria-label="Open image: ${esc(p.title)}, ${esc(p.cat)}">

                <img class="photo" src="${p.image}" alt="${esc(`${p.cat} â€” ${p.title}`)}" width="${p.w}" height="${p.h}" loading="lazy">

                <span class="asd-shot__overlay"><span class="asd-shot__cat">${esc(p.cat)}</span><span class="asd-shot__title">${esc(p.title)}</span></span>

                <span class="asd-shot__plus" aria-hidden="true">${icon('plus')}</span>

            </button>`;

    };



    const render = (animate) => {

        cols = columnCount();

        grid.innerHTML = arrange(cols).map((c) => `<div class="asd-bento__col">${c.map(shotHTML).join('')}</div>`).join('');

        grid.classList.toggle('is-entering', animate);

        const label = current === 'all' ? 'All categories' : cats.find((c) => c.id === current).name;

        status.textContent = `${label} Â· ${list.length} photographs`;

    };

    render(false);



    filters.addEventListener('click', (e) => {

        const btn = e.target.closest('[data-cat]');

        if (!btn || btn.dataset.cat === current) return;

        current = btn.dataset.cat;

        list = current === 'all' ? all : byCat[current];

        $$('[data-cat]', filters).forEach((b) => {

            const on = b === btn;

            b.classList.toggle('is-active', on);

            b.setAttribute('aria-pressed', String(on));

        });

        clearTimeout(swapTimer);

        if (prefersReducedMotion.matches) { render(false); return; }

        grid.classList.add('is-filtering');

        swapTimer = setTimeout(() => {

            render(true);

            grid.classList.remove('is-filtering');

            if (filters.getBoundingClientRect().top < 0) filters.scrollIntoView({ block: 'start', behavior: 'smooth' });

        }, 300);

    });



    let resizeRaf;

    window.addEventListener('resize', () => {

        cancelAnimationFrame(resizeRaf);

        resizeRaf = requestAnimationFrame(() => { if (columnCount() !== cols) render(false); });

    });



    grid.addEventListener('click', (e) => {

        const shot = e.target.closest('.asd-shot');

        if (!shot) return;

        const items = list.map((p) => ({ image: p.image, title: p.title, season: p.cat, alt: `${p.cat} â€” ${p.title}` }));

        Lightbox.open(items, Number(shot.dataset.index), shot);

    });

}



