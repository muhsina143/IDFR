function initBrandsPopup() {

    const popup = $('#brandsPopup');



    // Banner slider: slides and dots are written in the popup's markup

    const banner = $('.brands-pop__banner', popup);

    const INTERVAL = 4000;

    const slides = $$('.brands-pop__slide', banner);

    const dots = $$('.brands-pop__dot', banner);

    const total = slides.length;

    const titleOf = (slide) => $('.brands-pop__caption', slide).textContent.replace(/\s+/g, ' ').trim();

    let index = 0;

    let timer = null;

    // Reasons to hold the autoplay: keyboard focus, pointer on an arrow, a touch in progress

    const holds = new Set();



    const showSlide = (n, announce = false) => {

        index = (n + total) % total;

        slides.forEach((s, i) => {

            const on = i === index;

            s.classList.toggle('is-active', on);

            s.inert = !on;

            if (on) s.removeAttribute('aria-hidden'); else s.setAttribute('aria-hidden', 'true');

        });

        dots.forEach((d, i) => {

            if (i === index) d.setAttribute('aria-current', 'true'); else d.removeAttribute('aria-current');

        });

        $('#brandsPopCurrent').textContent = pad(index + 1);

        $('#brandsPopStatus').textContent = announce ? `Banner ${index + 1} of ${total}: ${titleOf(slides[index])}` : '';

    };

    const schedule = () => {

        clearTimeout(timer);

        if (!Modal.isOpen(popup) || holds.size || document.hidden || prefersReducedMotion.matches) return;

        timer = setTimeout(() => { showSlide(index + 1); schedule(); }, INTERVAL);

    };

    const hold = (reason, on) => {

        if (on) holds.add(reason); else holds.delete(reason);

        schedule();

    };

    const step = (d) => { showSlide(index + d, true); schedule(); };



    banner.addEventListener('click', (e) => {

        const arrow = e.target.closest('[data-banner-step]');

        if (arrow) step(Number(arrow.dataset.bannerStep));

        const dot = e.target.closest('[data-banner-dot]');

        if (dot) { showSlide(Number(dot.dataset.bannerDot), true); schedule(); }

    });

    banner.addEventListener('keydown', (e) => {

        if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }

        else if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }

    });

    banner.addEventListener('focusin', (e) => hold('focus', e.target.matches(':focus-visible')));

    banner.addEventListener('focusout', (e) => { if (!banner.contains(e.relatedTarget)) hold('focus', false); });

    $$('.brands-pop__arrow, .brands-pop__dots', banner).forEach((a) => {

        a.addEventListener('pointerenter', (e) => { if (e.pointerType === 'mouse') hold('arrow', true); });

        a.addEventListener('pointerleave', () => hold('arrow', false));

    });

    let startX = null;

    banner.addEventListener('pointerdown', (e) => {

        if (e.pointerType === 'mouse' || e.target.closest('button')) return;

        startX = e.clientX;

        hold('touch', true);

    });

    const endTouch = (e) => {

        if (startX === null) return;

        const dx = e.clientX - startX;

        startX = null;

        holds.delete('touch');

        if (e.type === 'pointerup' && Math.abs(dx) > 40) step(dx < 0 ? 1 : -1);

        else schedule();

    };

    banner.addEventListener('pointerup', endTouch);

    banner.addEventListener('pointercancel', endTouch);

    document.addEventListener('visibilitychange', schedule);



    // Brand logos enter one after another: the first slides in from the left edge of the

    // screen, each next one comes out from behind the previous tile and rolls into place

    const items = $$('.brands-pop__item', popup);

    let anims = [];

    const animateLogos = () => {

        anims.forEach((a) => a.cancel());

        anims = [];

        items.forEach((li) => li.classList.remove('is-landed'));

        if (prefersReducedMotion.matches || !Element.prototype.animate) {

            items.forEach((li) => li.classList.add('is-landed'));

            return;

        }

        const logos = items.map((li) => $('.brands-pop__logo', li));

        const rects = logos.map((l) => l.getBoundingClientRect());

        const START = 450;

        const FIRST = 1000;

        const NEXT = 950;

        const STAGGER = 760;

        const easing = 'cubic-bezier(0.22, 1, 0.36, 1)';

        logos.forEach((logo, i) => {

            const r = rects[i];

            let keyframes;

            if (i === 0) {

                keyframes = [{ transform: `translateX(${-Math.ceil(r.right + 24)}px)` }, { transform: 'none' }];

            } else {

                const p = rects[i - 1];

                keyframes = [

                    { transform: `translate(${p.left - r.left}px, ${p.top - r.top}px) rotate(-90deg) scale(0.86)`, opacity: 0, offset: 0 },

                    { opacity: 1, offset: 0.06 },

                    { transform: 'none', opacity: 1 }

                ];

            }

            const delay = i ? START + FIRST - 150 + (i - 1) * STAGGER : START;

            const anim = logo.animate(keyframes, { duration: i ? NEXT : FIRST, delay, easing, fill: 'backwards' });

            anim.finished.then(() => items[i].classList.add('is-landed')).catch(() => { });

            anims.push(anim);

        });

    };



    popup.addEventListener('modal:open', () => {

        showSlide(0);

        animateLogos();

        schedule();

    });

    popup.addEventListener('modal:close', () => {

        clearTimeout(timer);

        anims.forEach((a) => a.finish());

    });



    const openPopup = () => {

        if (Modal.isOpen(popup)) return;

        if (Modal.top() || MobileMenu.isOpen) return;

        // Dismiss the preloader immediately so it never paints over / ahead of the popup

        document.body.classList.add('is-loaded');

        document.documentElement.classList.remove('brands-pop-first');

        Modal.open(popup);

        // Above .preloader (z-index 999); Modal.open assigns a lower inline z-index

        popup.style.zIndex = '1000';

    };



    const syncBrandsPopHistory = (mode) => {

        history.replaceState({ [BRANDS_POP_STATE]: mode }, '', brandsPopUrl(mode === 'open'));

    };



    const seedHeroHistory = () => {

        // Underlay an "open" entry, then land on "closed" (hero) so Back opens the popup

        history.replaceState({ [BRANDS_POP_STATE]: 'open' }, '', brandsPopUrl(true));

        history.pushState({ [BRANDS_POP_STATE]: 'closed' }, '', brandsPopUrl(false));

    };



    // Show the site preloader over the page, then reveal the hero

    const playEntryPreloader = () => {

        document.documentElement.classList.remove('brands-pop-first');

        const pre = document.querySelector('.preloader');

        if (pre) {

            // Appear instantly (skip the slide-in) so the cover is visible right away

            pre.style.transition = 'none';

            document.body.classList.remove('is-loaded');

            // Restart logo / line animations

            const inner = pre.querySelector('.preloader__inner');

            if (inner) inner.replaceWith(inner.cloneNode(true));

            void pre.offsetWidth;

            pre.style.transition = '';

        } else {

            document.body.classList.remove('is-loaded');

        }

        // Hold long enough to read the preloader, then lift it to show the hero

        setTimeout(() => document.body.classList.add('is-loaded'), 1800);

    };



    const enterHero = () => {

        if (!history.state || history.state[BRANDS_POP_STATE] !== 'closed') {

            history.pushState({ [BRANDS_POP_STATE]: 'closed' }, '', brandsPopUrl(false));

        } else {

            syncBrandsPopHistory('closed');

        }

        // Close + hide immediately so the preloader (z-index 999) isn't covered by the modal (1000)

        if (Modal.isOpen(popup)) Modal.close(popup);

        clearTimeout(popup._hideTimer);

        popup.classList.remove('is-open');

        popup.hidden = true;

        popup.style.zIndex = '';



        const hero = $('#asd-home');

        if (hero) hero.scrollIntoView({ block: 'start', behavior: 'auto' });

        playEntryPreloader();

    };



    const applyBrandsPopState = (mode) => {

        if (mode === 'open') openPopup();

        else if (Modal.isOpen(popup)) Modal.close(popup);

    };



    const show = () => {

        if (consumeSkipBrandsPop()) {

            document.documentElement.classList.remove('brands-pop-first');

            // Entered via Explore / ASD Home nav — show hero, keep Back → popup

            if (history.state && history.state[BRANDS_POP_STATE] === 'closed') {

                syncBrandsPopHistory('closed');

            } else {

                seedHeroHistory();

            }

            // Links use #home; the section id is asd-home

            const hero = $('#asd-home');

            if (hero && (location.hash === '#home' || location.hash === '#asd-home')) {

                requestAnimationFrame(() => hero.scrollIntoView({ block: 'start', behavior: 'auto' }));

            }

            return;

        }

        // Restored via Back / bfcache with an explicit state

        if (history.state && history.state[BRANDS_POP_STATE] === 'closed') {

            document.documentElement.classList.remove('brands-pop-first');

            return;

        }

        syncBrandsPopHistory('open');

        openPopup();

    };



    show();



    window.addEventListener('popstate', (e) => {

        const mode = e.state && e.state[BRANDS_POP_STATE];

        if (mode === 'open' || mode === 'closed') applyBrandsPopState(mode);

    });



    // bfcache restores can skip popstate — re-sync popup to history state

    window.addEventListener('pageshow', (e) => {

        if (!e.persisted) return;

        const mode = history.state && history.state[BRANDS_POP_STATE];

        if (mode === 'open' || mode === 'closed') applyBrandsPopState(mode);

    });



    // Leaving asdreams for index while on the hero: Back should reopen the brands popup

    document.addEventListener('click', (e) => {

        if (e.defaultPrevented || e.button !== 0 || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;

        const a = e.target.closest('a[href]');

        if (!a || a.closest('#brandsPopup')) return;

        if (!isIndexLink(a.getAttribute('href') || '')) return;

        if (history.state && history.state[BRANDS_POP_STATE] === 'closed') {

            syncBrandsPopHistory('open');

        }

        markReturnBrandsPop();

        clearSkipBrandsPop();

    });



    popup.addEventListener('click', (e) => {

        const link = e.target.closest('.brands-pop__link, .brands-pop__cta');

        if (!link) return;



        const href = link.getAttribute('href') || '';



        // ASDreamStudio tile: preloader → hero; Back reopens the brands popup

        if (link.classList.contains('brands-pop__link') && isAsdreamsHomeLink(href)) {

            e.preventDefault();

            enterHero();

            return;

        }



        // IDFR (and any index link): Back from index returns to the brands popup

        if (link.classList.contains('brands-pop__link') && isIndexLink(href)) {

            markReturnBrandsPop();

            clearSkipBrandsPop();

            syncBrandsPopHistory('open');

        }



        Modal.close(popup);

    });

}



