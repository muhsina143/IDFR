                <span class="g-item__plus" aria-hidden="true">${icon('plus')}</span>

            </button>`;

    };



    // Tile heights are in column widths plus a nominal gap, so they compare at any size

    const render = (animate = true) => {

        list = DATA.gallery.filter((g) => season === 'all' || g.season === season);

        cols = columnCount();

        grid.innerHTML = balanceColumns(list.map((g) => g.h / g.w + 0.04), cols)

            .map((c) => `<div class="gallery__col">${c.map(itemHTML).join('')}</div>`).join('');

        grid.classList.toggle('is-static', !animate);

    };

    render();



    let resizeRaf;

    window.addEventListener('resize', () => {

        cancelAnimationFrame(resizeRaf);

        resizeRaf = requestAnimationFrame(() => { if (columnCount() !== cols) render(false); });

    });



    filters.addEventListener('click', (e) => {

        const btn = e.target.closest('.filter-btn');

        if (!btn || btn.dataset.season === season) return;

        season = btn.dataset.season;

        $$('.filter-btn', filters).forEach((b) => {

