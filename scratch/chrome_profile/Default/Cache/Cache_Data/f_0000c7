   ASDREAMSTUDIO PAGE â€” hero capture slider, showreel, category carousel

   ------------------------------------------------------------------------- */

function initAsdHero() {

    const hero = $('#asd-home');

    const stage = $('#asdSlides');

    const frame = $('#asdFrame');

    const caption = $('#asdCaption');

    const progress = $('#asdProgress');

    const pauseBtn = $('#asdPause');

    const slides = DATA.asdHero;

    const n = slides.length;

    const INTERVAL = 4000;

    const FRAME_DELAY = 450;

    const FRAME_VISIBLE = 2000;

    let index = 0;

    let playing = true;

    let inView = true;

    let timer, frameIn, frameOut;



    stage.innerHTML = slides.map((s, i) => `

        <figure class="asd-slide" data-i="${i}" aria-roledescription="slide" aria-label="${i + 1} of ${n}: ${esc(s.title)}">

            <img class="photo" src="${s.image}" alt="${esc(s.alt)}" width="1100" height="900"${i > 1 && i < n - 1 ? ' loading="lazy"' : ''}>

        </figure>`).join('');

    const els = $$('.asd-slide', stage);

    $('#asdTotal').textContent = pad(n);



    const place = () => {

        els.forEach((el, i) => {

            let d = (i - index + n) % n;

            if (d > n / 2) d -= n;

            el.dataset.pos = d === 0 ? 'current' : d === -1 ? 'prev' : d === 1 ? 'next' : d < 0 ? 'far-prev' : 'far-next';

            el.setAttribute('aria-hidden', String(d !== 0));

        });

        $('#asdCurrent').textContent = pad(index + 1);

        $('#asdCaptionTitle').textContent = slides[index].title;

        $('#asdCaptionMeta').textContent = slides[index].meta;

    };



    const capture = () => {

        clearTimeout(frameIn);

        clearTimeout(frameOut);

        frame.classList.remove('is-on');

        frameIn = setTimeout(() => {

            frame.classList.add('is-on');

            frameOut = setTimeout(() => frame.classList.remove('is-on'), FRAME_VISIBLE);

        }, FRAME_DELAY);

    };



    const schedule = () => {

        clearTimeout(timer);

        progress.classList.remove('run');

        const active = playing && inView && !document.hidden;

        if (!active) return;

        void progress.offsetWidth;

        progress.classList.add('run');

        timer = setTimeout(() => go(index + 1), INTERVAL);

    };



    function go(to) {

        index = (to + n) % n;

        place();

        capture();

        schedule();

    }



    $('#asdPrev').addEventListener('click', () => go(index - 1));

    $('#asdNext').addEventListener('click', () => go(index + 1));

    stage.addEventListener('click', (e) => {

        const slide = e.target.closest('.asd-slide');

        if (!slide) return;

        if (slide.dataset.pos === 'prev') go(index - 1);

        else if (slide.dataset.pos === 'next') go(index + 1);

    });

    hero.addEventListener('keydown', (e) => {

        if (e.key === 'ArrowLeft') { e.preventDefault(); go(index - 1); }

        else if (e.key === 'ArrowRight') { e.preventDefault(); go(index + 1); }

    });



    pauseBtn.addEventListener('click', () => {

        playing = !playing;

        pauseBtn.setAttribute('aria-label', playing ? 'Pause slideshow' : 'Play slideshow');

        pauseBtn.innerHTML = icon(playing ? 'pause' : 'play');

        caption.setAttribute('aria-live', playing ? 'off' : 'polite');

        schedule();

    });



    let startX = null;

    stage.addEventListener('pointerdown', (e) => { if (e.pointerType !== 'mouse') startX = e.clientX; });

    stage.addEventListener('pointerup', (e) => {

        if (startX === null) return;

        const dx = e.clientX - startX;

        startX = null;

        if (Math.abs(dx) > 40) go(index + (dx < 0 ? 1 : -1));

    });

    stage.addEventListener('pointercancel', () => { startX = null; });



    new IntersectionObserver(([entry]) => {

        inView = entry.isIntersecting;

        schedule();

    }, { threshold: 0.25 }).observe(hero);

    document.addEventListener('visibilitychange', schedule);



    go(0);

}



