function initProfileGallery() {

    const root = $('#profileGallery');

    const stage = $('.pg__stage', root);

    const slides = $$('.pg__slide', root);

    const thumbs = $$('.pg__thumb', root);

    const current = $('.pg__current', root);

    const status = $('.pg__status', root);

    let index = 0;



    $('.pg__total', root).textContent = pad(slides.length);



    const go = (i) => {

        index = (i + slides.length) % slides.length;

        slides.forEach((s, n) => {

            const on = n === index;

            s.classList.toggle('is-active', on);

            s.setAttribute('aria-hidden', String(!on));

        });

        thumbs.forEach((t, n) => {

            const on = n === index;

            t.classList.toggle('is-active', on);

            t.setAttribute('aria-current', String(on));

        });

        current.textContent = pad(index + 1);

        status.textContent = `Image ${index + 1} of ${slides.length}`;

    };



    $('.pg__nav--prev', root).addEventListener('click', () => go(index - 1));

    $('.pg__nav--next', root).addEventListener('click', () => go(index + 1));

    thumbs.forEach((t, n) => t.addEventListener('click', () => go(n)));



    root.addEventListener('keydown', (e) => {

        if (e.key === 'ArrowLeft') { e.preventDefault(); go(index - 1); }

        else if (e.key === 'ArrowRight') { e.preventDefault(); go(index + 1); }

    });



    let startX = null;

    stage.addEventListener('pointerdown', (e) => {

        if (e.pointerType !== 'mouse' && !e.target.closest('.pg__nav, .pg__edit')) startX = e.clientX;

    });

    stage.addEventListener('pointerup', (e) => {

        if (startX === null) return;

        const dx = e.clientX - startX;

        startX = null;

        if (Math.abs(dx) > 40) go(index + (dx < 0 ? 1 : -1));

    });

    stage.addEventListener('pointercancel', () => { startX = null; });



    // Edit icon: pick a local image and swap it into the active slide (+ matching thumb)

    const fileInput = document.createElement('input');

    fileInput.type = 'file';

    fileInput.accept = 'image/*';

    fileInput.className = 'visually-hidden';

    fileInput.setAttribute('tabindex', '-1');

    fileInput.setAttribute('aria-hidden', 'true');

    root.appendChild(fileInput);



    let editIndex = -1;

    const blobUrls = new WeakMap();



    root.addEventListener('click', (e) => {

        const btn = e.target.closest('[data-pg-edit]');

        if (!btn) return;

        e.preventDefault();

        e.stopPropagation();

        const slide = btn.closest('.pg__slide');

        editIndex = slides.indexOf(slide);

        if (editIndex < 0) return;

        fileInput.value = '';

        fileInput.click();

    });



    fileInput.addEventListener('change', () => {

        const file = fileInput.files && fileInput.files[0];

        if (!file || !file.type.startsWith('image/') || editIndex < 0) return;

        const slideImg = $('img', slides[editIndex]);

        const thumbImg = thumbs[editIndex] && $('img', thumbs[editIndex]);

        if (!slideImg) return;



        const prev = blobUrls.get(slideImg);

        const url = URL.createObjectURL(file);

        blobUrls.set(slideImg, url);

        slideImg.src = url;

        if (thumbImg) thumbImg.src = url;

        if (prev) URL.revokeObjectURL(prev);

        window.__profilePendingFiles = window.__profilePendingFiles || {};
        const fieldName = editIndex === 0 ? 'profile_photo' : (editIndex === 1 ? 'portfolio_image_1' : 'portfolio_image_2');
        window.__profilePendingFiles[fieldName] = file;

        const targetInput = document.getElementById(
            editIndex === 0 ? 'pfFile_profile_photo' : (editIndex === 1 ? 'pfFile_portfolio_1' : 'pfFile_portfolio_2')
        );
        if (targetInput) {
            try {
                const dt = new DataTransfer();
                dt.items.add(file);
                targetInput.files = dt.files;
            } catch (_) {}
        }

        status.textContent = `Image ${editIndex + 1} of ${slides.length} updated`;

        editIndex = -1;

    });

}



function initPlaceCombo(combo, places) {

    const input = $('input', combo);

    const list = $('.combo__list', combo);

    let matches = [];

    let active = -1;



    const canonical = (value) => places.find((p) => p.toLowerCase() === value.trim().toLowerCase());



    const validate = () => {

        const match = canonical(input.value);

        if (match) input.value = match;

        input.setCustomValidity(input.value.trim() && !match ? 'Please choose a place from the list.' : '');

    };



    const setActive = (i) => {

        active = i;

        $$('.combo__option', list).forEach((o, n) => {

            const on = n === active;

            o.classList.toggle('is-active', on);

            o.setAttribute('aria-selected', String(on));

            if (on) o.scrollIntoView({ block: 'nearest' });

        });

        if (active >= 0) input.setAttribute('aria-activedescendant', `pfPlaceOpt${active}`);

        else input.removeAttribute('aria-activedescendant');

    };



    const close = () => {

        list.hidden = true;

        input.setAttribute('aria-expanded', 'false');

        setActive(-1);

    };



    const render = () => {

        const q = input.value.trim().toLowerCase();

        matches = q ? places.filter((p) => p.toLowerCase().includes(q)) : places.slice();

        matches.sort((a, b) => Number(!a.toLowerCase().startsWith(q)) - Number(!b.toLowerCase().startsWith(q)));

        list.innerHTML = matches.length

            ? matches.map((p, i) => `<li class="combo__option" id="pfPlaceOpt${i}" role="option" aria-selected="false" data-value="${esc(p)}">${esc(p)}</li>`).join('')

            : '<li class="combo__empty" role="option" aria-disabled="true" aria-selected="false">No matching place</li>';

        list.hidden = false;

        input.setAttribute('aria-expanded', 'true');

        setActive(-1);

    };



    const choose = (value) => {

        input.value = value;

        input.setCustomValidity('');

        close();

        const field = input.closest('.field');

        field.classList.remove('has-error');

        $('.field__error', field).textContent = '';

        input.setAttribute('aria-invalid', 'false');

    };



    input.addEventListener('focus', render);

    input.addEventListener('click', () => { if (list.hidden) render(); });

    input.addEventListener('input', () => { input.setCustomValidity(''); render(); });

    input.addEventListener('keydown', (e) => {

        if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {

            e.preventDefault();

            if (list.hidden) render();

            if (!matches.length) return;

            const step = e.key === 'ArrowDown' ? 1 : -1;

            setActive((active + step + matches.length) % matches.length);

        } else if (e.key === 'Enter' && !list.hidden) {

            e.preventDefault();

            if (active >= 0) choose(matches[active]);

            else if (matches.length === 1) choose(matches[0]);

        } else if (e.key === 'Escape' && !list.hidden) {

            e.preventDefault();

            e.stopPropagation();

            close();

        } else if (e.key === 'Tab') {

            if (active >= 0) choose(matches[active]);

            else close();

        }

    });

    list.addEventListener('mousedown', (e) => e.preventDefault());

    list.addEventListener('click', (e) => {

        const opt = e.target.closest('.combo__option');

        if (opt) choose(opt.dataset.value);

    });

    input.addEventListener('blur', () => { close(); validate(); });



    return { validate, reset: () => { input.setCustomValidity(''); close(); } };

}



function initProfileForm() {

    const form = $('#profileForm');

    const kind = form.dataset.profileKind || 'model';



    // Creative professional pages: form behaviour lives in js/creative_profiles.js

    // (content and field markup stay in each *_profile.html).

    if (kind === 'creative') {

        if (typeof initCreativeProfileForm === 'function') initCreativeProfileForm(form);

        return;

    }



    const placeEl = $('#placeCombo');

    const place = placeEl ? initPlaceCombo(placeEl, DATA.places) : null;

    const types = $$('input[name="modelType"]', form);

    const height = $('#pfHeight');

    const heightHint = $('#pfHeightHint');



    const syncTypes = () => types[0].setCustomValidity(types.some((t) => t.checked) ? '' : 'Please select at least one model type.');

    const syncHeight = () => {

        const cm = Number(height.value);

        if (!height.value || cm < 120 || cm > 215) { heightHint.textContent = 'In centimetres'; return; }

        const inches = Math.round(cm / 2.54);

        heightHint.textContent = `â‰ˆ ${Math.floor(inches / 12)}'${inches % 12}" (feet & inches)`;

    };



    types.forEach((t) => t.addEventListener('change', syncTypes));

    height.addEventListener('input', syncHeight);

    syncTypes();



    form.addEventListener('submit', async (e) => {

        e.preventDefault();

        if (place) place.validate();

        syncTypes();

        if (!validateForm(form)) return;



        const submitBtn = form.querySelector('button[type="submit"]');

        if (submitBtn) submitBtn.disabled = true;



        if (form.action && form.action !== '' && !form.action.endsWith('#')) {

            try {

                const formData = new FormData(form);
                if (window.__profilePendingFiles) {
                    if (window.__profilePendingFiles.profile_photo) {
                        formData.set('profile_photo', window.__profilePendingFiles.profile_photo);
                    }
                    if (window.__profilePendingFiles.portfolio_image_1) {
                        formData.set('portfolio_image_1', window.__profilePendingFiles.portfolio_image_1);
                    }
                    if (window.__profilePendingFiles.portfolio_image_2) {
                        formData.set('portfolio_image_2', window.__profilePendingFiles.portfolio_image_2);
                    }
                }

                const csrf = form.querySelector('input[name="_token"]')?.value || document.querySelector('meta[name="csrf-token"]')?.getAttribute('content');

                const res = await fetch(form.action, {

                    method: form.method || 'POST',

                    headers: {

                        'X-Requested-With': 'XMLHttpRequest',

                        'Accept': 'application/json',

                        ...(csrf ? { 'X-CSRF-TOKEN': csrf } : {}),

                    },

                    body: formData,

                });

                const data = await res.json().catch(() => null);

                if (res.ok && data?.success) {
                    window.__profilePendingFiles = {};

                    toast(data.message || 'Your model profile has been saved.');

                    if (submitBtn) submitBtn.disabled = false;

                    return;

                } else if (res.status === 422 && data?.errors) {

                    const firstErr = Object.values(data.errors)[0];

                    toast(Array.isArray(firstErr) ? firstErr[0] : 'Validation failed.');

                    if (submitBtn) submitBtn.disabled = false;

                    return;

                }

            } catch (err) {

                console.warn('Model profile save fetch error, falling back to native submit', err);

            }

            if (submitBtn) submitBtn.disabled = false;

            form.submit();

            return;

        }



        const name = $('#pfName') ? $('#pfName').value.trim() : 'User';

        toast(`Thank you, ${name}. Your model profile has been saved.`);

        if (submitBtn) submitBtn.disabled = false;

    });



    form.addEventListener('reset', () => {

        if (place) place.reset();

        clearFormErrors(form);

        setTimeout(() => { syncTypes(); syncHeight(); }, 0);

    });

}



