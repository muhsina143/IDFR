    $('.model-modal__nav--prev', media).addEventListener('click', () => showModelSlide(modelSlide - 1));

    $('.model-modal__nav--next', media).addEventListener('click', () => showModelSlide(modelSlide + 1));

    media.addEventListener('keydown', (e) => {

        if (e.key === 'ArrowLeft') { e.preventDefault(); showModelSlide(modelSlide - 1); }

        else if (e.key === 'ArrowRight') { e.preventDefault(); showModelSlide(modelSlide + 1); }

    });



    let startX = null;

    media.addEventListener('pointerdown', (e) => {

        if (e.pointerType !== 'mouse' && !e.target.closest('.model-modal__nav')) startX = e.clientX;

    });

    media.addEventListener('pointerup', (e) => {

        if (startX === null) return;

        const dx = e.clientX - startX;

        startX = null;

        if (Math.abs(dx) > 40 && $$('.model-modal__slide', media).length > 1) showModelSlide(modelSlide + (dx < 0 ? 1 : -1));

    });

    media.addEventListener('pointercancel', () => { startX = null; });



    body.addEventListener('click', async (e) => {

        if (!currentModel) return;

        if (e.target.closest('[data-enquire]') || e.target.closest('[data-model-contact]')) {

            e.preventDefault();

            handleModelContact(currentModel);

        } else if (e.target.closest('[data-enquiry-back]')) {

            body.innerHTML = modelProfileHTML(currentModel);

            $('[data-model-contact]', body)?.focus();

        } else if (e.target.closest('[data-share]')) {

            const url = `${location.href.split('#')[0]}#model-${currentModel.id}`;

            try {

                await navigator.clipboard.writeText(url);

                toast(`Profile link for ${currentModel.name} copied to clipboard.`);

