const rupees = (n) => `â‚¹${n.toLocaleString('en-IN')}`;



function initBooking() {

    const form = $('#bookingForm');

    const type = $('#bkType');

    const seat = $('#bkSeat');

    const ticketTypes = $$('option:not([value=""])', type).map((o) => ({ id: o.value, name: o.textContent, perks: o.dataset.perks }));

    const seating = $$('option:not([value=""])', seat).map((o) => ({ id: o.value, name: o.dataset.name, price: Number(o.dataset.price), note: o.dataset.note }));

    const qty = $('#bkQty');

    const email = $('#bkEmail');

    const typeHint = $('#bkTypeHint');

    const typeHintDefault = typeHint.textContent;

    const prices = $('#bookingPrices');

    const submit = $('button[type="submit"]', form);

    const label = $('span', submit);

    const done = $('#bookingDone');

    const min = Number(qty.min);

    const max = Number(qty.max);



    prices.innerHTML = seating.map((s) => `<li data-seat="${s.id}"><span>${esc(s.name)}<small>${esc(s.note)}</small></span><strong>${rupees(s.price)}</strong></li>`).join('');



    const selected = () => ({

        t: ticketTypes.find((x) => x.id === type.value),

        s: seating.find((x) => x.id === seat.value),

        n: Number.isInteger(Number(qty.value)) && qty.value !== '' && qty.checkValidity() ? Number(qty.value) : 0

    });



    const update = () => {

        const { t, s, n } = selected();

        const v = Number(qty.value) || 0;

        typeHint.textContent = t ? t.perks : typeHintDefault;

        $('#sumType').textContent = t ? t.name : 'â€”';

        $('#sumSeat').textContent = s ? s.name : 'â€”';

        $('#sumPrice').textContent = s ? rupees(s.price) : 'â€”';

        $('#sumQty').textContent = n || 'â€”';

        $('#sumTotal').textContent = rupees(s && n ? s.price * n : 0);

        $$('li', prices).forEach((li) => li.classList.toggle('is-active', Boolean(s) && li.dataset.seat === s.id));

        $$('[data-qty]', form).forEach((b) => { b.disabled = Number(b.dataset.qty) < 0 ? v <= min : v >= max; });

    };



    const checkEmail = () => {

        const v = email.value.trim();

        email.setCustomValidity(v && !/^[^@\s]+@[^@\s]+\.[^@\s]{2,}$/.test(v) ? 'Please enter a valid email address.' : '');

