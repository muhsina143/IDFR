    window.addEventListener('hashchange', openFromHash);

    openFromHash();



    // Return to #modelGrid in place â€” pin scroll, no animation, no jump to index.html#home

    modal.addEventListener('modal:close', () => {

        if (currentPro || profileModalReturn?.kind !== 'model') return;

        setTimeout(() => {

            if (Modal.isOpen($('#authModal'))) {

                profileModalReturn = null;

                return;

            }

            settleProfileReturn('model');

        }, 0);

    });

