        setTimeout(() => {

            $('#bookingDoneText').textContent = `Thank you, ${name}. ${n} Ã— ${t.name} ticket${n > 1 ? 's' : ''} with ${s.name}, total ${rupees(s.price * n)}. Your booking reference is ${ref} â€” confirmation will be sent to ${to} (demo).`;

            form.reset();

            clearFormErrors(form);

            update();

            submit.disabled = false;

            label.textContent = 'Submit';

            done.hidden = false;

            done.focus();

        }, 800);

    });



    update();

}



