let profileModalReturn = null;



function rememberProfileReturn(kind, detail = {}) {

    profileModalReturn = {

        kind,

        scrollY: window.scrollY || document.documentElement.scrollTop || 0,

        ...detail

    };

}



function settleProfileReturn(kind) {

    const ctx = profileModalReturn;

    if (!ctx || ctx.kind !== kind) return null;

    profileModalReturn = null;

    const y = Number.isFinite(ctx.scrollY) ? ctx.scrollY : lockedScrollY;

    if (ctx.hash) history.replaceState(null, '', `${location.pathname}${location.search}${ctx.hash}`);

    // Restore without animation â€” prefer the saved Y; fall back to the opened card

    window.scrollTo(0, y);

    document.documentElement.scrollTop = y;

    document.body.scrollTop = y;

    requestAnimationFrame(() => {

        window.scrollTo(0, y);

        if (Math.abs((window.scrollY || document.documentElement.scrollTop || 0) - y) <= 40) return;

        const el = ctx.kind === 'model'

            ? $(`[data-model-open="${ctx.modelId}"]`)?.closest('.model-card')

            : $(`[data-pro-open="${ctx.proId}"]`)?.closest('.creative-card');

        (el || (ctx.kind === 'model' ? $('#modelGrid') : $('.creative-pros__grid')))

            ?.scrollIntoView({ block: 'center', behavior: 'auto' });

    });

    return ctx;

}



