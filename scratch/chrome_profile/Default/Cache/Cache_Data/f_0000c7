}



async function sharePro(p) {

    const url = new URL(`#pro-${p.id}`, location.href).href;

    const title = `${p.name} â€” ${p.profession} | IDFR`;

    if (navigator.share) {

        try {

            await navigator.share({ title, text: `${p.name}, ${p.profession} (${p.brand}). View the profile on IDFR.`, url });

            toast(`Profile of ${p.name} shared.`);

            return;

        } catch (err) {

            if (err.name === 'AbortError') return;

        }

    }

    try {

        await navigator.clipboard.writeText(url);

        toast(`Profile link for ${p.name} copied to clipboard.`);

    } catch (err) {

        toast(`Couldn't copy the link automatically. Share this profile: ${url}`);

    }

}



