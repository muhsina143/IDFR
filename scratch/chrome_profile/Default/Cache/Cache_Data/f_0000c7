};



let scrollLocks = 0;

let lockedScrollY = 0;

function lockScroll() {

    if (scrollLocks++ === 0) {

        lockedScrollY = window.scrollY || document.documentElement.scrollTop || 0;

        const sbw = window.innerWidth - document.documentElement.clientWidth;

        document.documentElement.style.setProperty('--sbw', `${sbw}px`);

        document.documentElement.classList.add('scroll-locked');

    }

}

function unlockScroll() {

    scrollLocks = Math.max(0, scrollLocks - 1);

    if (scrollLocks !== 0) return;

    const y = lockedScrollY;

    document.documentElement.classList.remove('scroll-locked');

    document.documentElement.style.setProperty('--sbw', '0px');

    window.scrollTo(0, y);

    document.documentElement.scrollTop = y;

    document.body.scrollTop = y;

}



const FOCUSABLE = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';

const focusablesIn = (root) => $$(FOCUSABLE, root).filter((el) => el.offsetParent !== null || el === document.activeElement);



let toastTimer;

function toast(message) {

    const el = $('#toast');

    el.innerHTML = `${icon('check')}<span></span>`;

    el.querySelector('span').textContent = message;

    el.classList.add('is-visible');

    clearTimeout(toastTimer);

    toastTimer = setTimeout(() => el.classList.remove('is-visible'), 4200);

}



/* Monochrome mock logos rendered as inline SVG; they inherit currentColor so

   hover states can switch them between black, white and gold. */

function logoSVG(logo, label) {

    if (!logo) return `<span class="lg-fallback">${esc(label || '')}</span>`;

    if (logo.src) return `<img src="${logo.src}" alt="${esc(label)} logo" loading="lazy" style="max-height: 48px; max-width: 140px; width: auto; height: auto; object-fit: contain;">`;

    const S = 'fill="none" stroke="currentColor" stroke-width="1.6"';

    const letter = (size = 22, y = 48) => `<text class="lg-mark" x="34" y="${y}" text-anchor="middle" font-size="${size}">${esc(logo.mark || '')}</text>`;

    const marks = {

        circle: `<circle cx="34" cy="40" r="25" ${S}/><circle cx="34" cy="40" r="20.5" fill="none" stroke="currentColor" stroke-width=".7"/>${letter()}`,

        diamond: `<path d="M34 12 62 40 34 68 6 40Z" ${S}/>${letter(20)}`,

        crest: `<path d="M12 15h44v24c0 15-11 23-22 28-11-5-22-13-22-28z" ${S}/>${letter(21, 46)}`,

        rings: `<circle cx="25" cy="40" r="17" ${S}/><circle cx="43" cy="40" r="17" ${S}/>`,

        bars: `<rect x="12" y="26" width="7" height="30" fill="currentColor"/><rect x="25" y="14" width="7" height="52" fill="currentColor"/><rect x="38" y="32" width="7" height="24" fill="currentColor"/><rect x="51" y="21" width="7" height="40" fill="currentColor"/>`,

        star: `<path d="m34 12 5 23 23 5-23 5-5 23-5-23-23-5 23-5z" fill="currentColor"/>`,

        crown: `<path d="M9 55 13 24l11 15 10-21 10 21 11-15 4 31z" ${S}/><path d="M9 62h50" ${S}/>`,

        arch: `<path d="M12 64V38a22 22 0 0 1 44 0v26" ${S}/><path d="M12 64h44" ${S}/>${letter(20, 54)}`,

        drop: `<path d="M34 12c10 14 18 23 18 33a18 18 0 0 1-36 0c0-10 8-19 18-33z" ${S}/>${letter(18, 54)}`,

        weave: `<path d="M8 28q13-12 26 0t26 0M8 40q13-12 26 0t26 0M8 52q13-12 26 0t26 0" ${S}/>`,

        hex: `<path d="M34 12 58 26v28L34 68 10 54V26z" ${S}/>${letter(20)}`,

        wave: `<path d="M8 46q13-14 26 0t26 0" ${S}/><path d="M8 34q13-14 26 0t26 0" ${S}/><circle cx="34" cy="18" r="5" fill="currentColor"/>`

    };

    const word = esc(logo.word || label || '');

    const size = word.length > 8 ? 16.5 : 19;

    const wordY = logo.sub ? 41 : 47;

    const sub = logo.sub ? `<text class="lg-sub" x="74" y="58" font-size="8.4" letter-spacing="3">${esc(logo.sub)}</text>` : '';

    return `<svg viewBox="0 0 240 80" role="img" aria-label="${esc(label)} logo" xmlns="http://www.w3.org/2000/svg">${marks[logo.style] || marks.circle}<text class="lg-word" x="74" y="${wordY}" font-size="${size}" letter-spacing="1.6">${word}</text>${sub}</svg>`;

}



function validateForm(form) {

    let firstInvalid = null;

    const fieldErrors = new Map();

    $$('input, select, textarea', form).forEach((el) => {

        const field = el.closest('.field');

        if (!field) return;

        const choice = el.type === 'radio' || el.type === 'checkbox' || el.tagName === 'SELECT';

        if (el.type !== 'password' && el.type !== 'number' && !choice) el.value = el.value.trimStart();

        const v = el.validity;

        let msg = '';

        if (v.valueMissing) msg = choice ? 'Please select an option.' : 'This field is required.';

        else if (v.badInput) msg = el.type === 'date' ? 'Please enter a valid date.' : 'Please enter a number.';

        else if (v.typeMismatch) msg = el.type === 'email' ? 'Please enter a valid email address.' : 'Please check this value.';

        else if (v.tooShort || (el.minLength > 0 && el.value.length < el.minLength && el.value.length > 0)) msg = `Please use at least ${el.minLength} characters.`;

        else if (v.rangeUnderflow || v.rangeOverflow) msg = el.type === 'date' && v.rangeUnderflow ? 'Please choose today or a future date.' : (el.min && el.max ? `Please enter a value between ${el.min} and ${el.max}.` : `Please enter a value ${v.rangeUnderflow ? `of at least ${el.min}` : `up to ${el.max}`}.`);

        else if (v.stepMismatch) msg = el.step === '0.5' ? 'Please use whole or half values (e.g. 2 or 2.5).' : 'Please enter a whole number.';

        else if (v.patternMismatch) msg = el.type === 'tel' ? 'Please enter a valid phone number.' : 'Please check the format.';

        else if (v.customError) msg = el.validationMessage;

        else if (el.dataset.match && el.value !== $(el.dataset.match, form).value) msg = 'Passwords do not match.';

        if (!fieldErrors.get(field)) fieldErrors.set(field, msg);

        el.setAttribute('aria-invalid', msg ? 'true' : 'false');

        if (msg && !firstInvalid) firstInvalid = el;

    });

    fieldErrors.forEach((msg, field) => {

        field.classList.toggle('has-error', Boolean(msg));

        const err = $('.field__error', field);

        if (err) err.textContent = msg;

    });

    if (firstInvalid) firstInvalid.focus();

    return !firstInvalid;

}



function clearFormErrors(form) {

    $$('.field', form).forEach((f) => f.classList.remove('has-error'));

    $$('.field__error', form).forEach((e) => { e.textContent = ''; });

    $$('[aria-invalid]', form).forEach((e) => e.removeAttribute('aria-invalid'));

}



/* -------------------------------------------------------------------------

   MODAL MANAGER â€” focus trap, ESC, stacking, scroll lock

   ------------------------------------------------------------------------- */

const Modal = (() => {

    const stack = [];

    const returnFocus = new WeakMap();



    function open(el, trigger) {

        if (stack.includes(el)) return;

        clearTimeout(el._hideTimer);

        returnFocus.set(el, trigger || document.activeElement);

        el.hidden = false;

        el.style.zIndex = String(200 + stack.length * 2);

        void el.offsetWidth;

        el.classList.add('is-open');

        stack.push(el);

        lockScroll();

        const target = $('[data-autofocus]', el) || focusablesIn(el)[0];

        setTimeout(() => target && target.focus({ preventScroll: true }), 80);

        el.dispatchEvent(new CustomEvent('modal:open'));

    }



    function close(el = stack[stack.length - 1]) {

        if (!el || !stack.includes(el)) return null;

        stack.splice(stack.indexOf(el), 1);

        el.classList.remove('is-open');

        el._hideTimer = setTimeout(() => { el.hidden = true; }, 450);

        unlockScroll();

        const back = returnFocus.get(el);

        if (back && document.contains(back) && back.offsetParent !== null) back.focus({ preventScroll: true });

        el.dispatchEvent(new CustomEvent('modal:close'));

        // Re-assert scroll after focus/listeners â€” keeps model/creative grids from jumping to top/home

        if (scrollLocks === 0) {

            const y = (el.id === 'modelModal' && profileModalReturn && Number.isFinite(profileModalReturn.scrollY))

                ? profileModalReturn.scrollY

                : lockedScrollY;

            window.scrollTo(0, y);

            requestAnimationFrame(() => window.scrollTo(0, y));

        }

        return back;

    }



    document.addEventListener('keydown', (e) => {

        const top = stack[stack.length - 1];

        if (!top) return;

        if (e.key === 'Escape') {

            e.preventDefault();

            close(top);

        } else if (e.key === 'Tab') {

            const items = focusablesIn(top);

            if (!items.length) return;

            const first = items[0];

            const last = items[items.length - 1];

            if (e.shiftKey && (document.activeElement === first || !top.contains(document.activeElement))) {

                e.preventDefault(); last.focus();

            } else if (!e.shiftKey && (document.activeElement === last || !top.contains(document.activeElement))) {

                e.preventDefault(); first.focus();

            }

        }

    });



    document.addEventListener('click', (e) => {

        const closer = e.target.closest('[data-close]');

        if (closer) {

            const m = closer.closest('.modal');

            if (m) close(m);

        }

    });



    return { open, close, top: () => stack[stack.length - 1], isOpen: (el) => stack.includes(el) };

})();



