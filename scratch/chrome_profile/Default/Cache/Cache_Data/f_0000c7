        qty.value = String(Math.min(max, Math.max(min, v)));

        qty.dispatchEvent(new Event('input', { bubbles: true }));

    }));



    // Editing a field clears its error until the next submit

    form.addEventListener('input', (e) => {

        done.hidden = true;

        if (e.target === email) checkEmail();

        const field = e.target.closest('.field');

        if (field && field.classList.contains('has-error')) {

            field.classList.remove('has-error');

            $('.field__error', field).textContent = '';

            e.target.removeAttribute('aria-invalid');

        }

        update();

    });



    form.addEventListener('submit', (e) => {

        e.preventDefault();

        checkEmail();

        if (submit.disabled || !validateForm(form)) return;

        const { t, s, n } = selected();

        const name = $('#bkName').value.trim();

        const to = email.value.trim();

        const ref = `IDFR-S4-${Math.floor(10000 + Math.random() * 90000)}`;

