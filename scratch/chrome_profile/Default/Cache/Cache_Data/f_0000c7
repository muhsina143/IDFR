        });

        grid.classList.add('is-filtering');

        setTimeout(() => { render(); grid.classList.remove('is-filtering'); }, 280);

    });



    grid.addEventListener('click', (e) => {

        const item = e.target.closest('.g-item');

        if (!item) return;

        Lightbox.open(list, Number(item.dataset.index), item);

    });

}



