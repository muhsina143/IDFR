/* -------------------------------------------------------------------------

   SCROLL REVEAL & COUNTERS

   ------------------------------------------------------------------------- */

function animateCount(el) {

    if (!el || el.dataset.animated === 'true') return;

    el.dataset.animated = 'true';



    const rawCount = el.dataset.count !== undefined ? String(el.dataset.count).trim() : '';

    const cleanNum = Number(rawCount.replace(/,/g, ''));

    if (isNaN(cleanNum)) {

        el.textContent = rawCount || el.textContent;

        return;

    }



    const padTo = Number(el.dataset.pad) || (rawCount.length > 1 && rawCount.startsWith('0') && !isNaN(Number(rawCount)) ? rawCount.length : 0);

    const format = (n) => (padTo ? String(n).padStart(padTo, '0') : n.toLocaleString('en-IN'));

    if (typeof prefersReducedMotion !== 'undefined' && prefersReducedMotion && prefersReducedMotion.matches) {

        el.textContent = format(cleanNum);

        return;

    }



    const duration = 1800;

    const start = performance.now();

    const tick = (now) => {

        const p = Math.min(1, (now - start) / duration);

        const eased = 1 - Math.pow(1 - p, 3);

        const current = p >= 1 ? cleanNum : Math.round(cleanNum * eased);

        el.textContent = format(current);

        if (p < 1) {

            requestAnimationFrame(tick);

        } else {

            el.textContent = format(cleanNum);

        }

    };

    requestAnimationFrame(tick);

}



function initReveal() {

    const items = $$('[data-reveal]');

    const counters = $$('[data-count]');



    if (!('IntersectionObserver' in window)) {

        items.forEach((el) => el.classList.add('is-visible'));

        counters.forEach(animateCount);

        return;

    }



    const io = new IntersectionObserver((entries) => {

        entries.forEach((entry) => {

            if (!entry.isIntersecting) return;

            entry.target.classList.add('is-visible');

            io.unobserve(entry.target);

        });

    }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });



    items.forEach((el) => {

        if (el.dataset.delay) el.style.transitionDelay = `${el.dataset.delay}ms`;

        io.observe(el);

    });



    const countIO = new IntersectionObserver((entries) => {

        entries.forEach((entry) => {

            if (!entry.isIntersecting) return;

            animateCount(entry.target);

            countIO.unobserve(entry.target);

        });

    }, { threshold: 0.6 });

    counters.forEach((c) => countIO.observe(c));

}



