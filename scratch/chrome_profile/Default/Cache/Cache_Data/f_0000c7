    function checkAuthStatus() {

        return fetch('/auth/me', { headers: { 'Accept': 'application/json' } })

            .then((r) => r.json())

            .then((data) => {

                if (data.authenticated && data.user) {

                    updateNavAuth(data.user);

                    return data.user;

                } else {

                    updateNavAuth(null);

                    return null;

                }

            })

            .catch(() => null);

    }



    function init() {

        modal = $('#authModal');

        tabs = $$('.auth-tab', modal);

        panels = $$('.auth-form', modal);



        tabs.forEach((t) => t.addEventListener('click', () => switchTab(t.dataset.tab)));

        $('.auth-tabs', modal).addEventListener('keydown', (e) => {

            if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;

            const current = tabs.find((t) => t.classList.contains('is-active'));

            if (!current) return;

            const next = current.dataset.tab === 'login' ? 'register' : 'login';

            switchTab(next, true);

        });



        $$('.auth-logout-btn').forEach((b) => b.addEventListener('click', handlePublicLogout));



        // 1. Login Form Submit

        const loginForm = $('#panelLogin');

        if (loginForm) {

            loginForm.addEventListener('submit', async (e) => {

                e.preventDefault();

                clearFormErrors(e.target);

                if (!validateForm(e.target)) return;



                const email = $('#loginEmail').value.trim();

                const password = $('#loginPassword').value;

                const remember = $('input[name="remember"]', e.target)?.checked || false;



                const submitBtn = $('button[type="submit"]', e.target);

                const originalLabel = submitBtn.innerHTML;

                submitBtn.disabled = true;

                submitBtn.innerHTML = `<span>Logging in...</span>`;



                try {

                    const res = await fetch('/login', {

                        method: 'POST',

                        headers: {

                            'Content-Type': 'application/json',

                            'Accept': 'application/json',

                            'X-CSRF-TOKEN': csrfToken()

                        },

                        body: JSON.stringify({ email, password, remember })

                    });

                    const data = await res.json();

                    if (res.ok && data.success) {

                        toast(data.message);

                        Modal.close(modal);

                        e.target.reset();

                        if (data.user) {

                            updateNavAuth(data.user);

                            document.dispatchEvent(new CustomEvent('auth:login', { detail: data.user }));

                        }

                    } else if (data.requires_verification) {

                        toast(data.message);

                        $('#verifyEmailInput').value = data.email;

                        $('#otpTargetEmail').textContent = data.email;

                        switchTab('verify');

                        if (data.resend_cooldown) {

                            startResendCooldown(data.resend_cooldown);

                        }

                        $('#verifyOtpInput').value = '';

                        $('#verifyOtpInput').focus();

                    } else {

                        setFieldError($('#loginPassword'), data.message || 'Invalid credentials.');

                        toast(data.message || 'Login failed.');

                    }

                } catch (err) {

                    toast('Connection error during login.');

                } finally {

                    submitBtn.disabled = false;

                    submitBtn.innerHTML = originalLabel;

                }

            });

        }



        // 2. Register Form Submit

        const regForm = $('#panelRegister');

        if (regForm) {

            regForm.addEventListener('submit', async (e) => {

                e.preventDefault();

                clearFormErrors(e.target);

                const formOk = validateForm(e.target);

                const terms = $('#regTerms');

                $('#regTermsError').textContent = terms.checked ? '' : 'Please accept the terms to continue.';

                if (!formOk || !terms.checked) return;



                const submitBtn = $('#regSubmitBtn') || $('button[type="submit"]', e.target);

                const originalLabel = submitBtn.innerHTML;

                submitBtn.disabled = true;

                submitBtn.innerHTML = `<span>Creating account...</span>`;



                const payload = {

                    name: $('#regName').value.trim(),

                    email: $('#regEmail').value.trim(),

                    phone: $('#regPhone').value.trim(),

                    role: $('#regRole').value,

                    password: $('#regPassword').value,

                    password_confirmation: $('#regConfirmPassword').value,

                    terms: terms.checked,

                };



                try {

                    const res = await fetch('/register', {

                        method: 'POST',

                        headers: {

                            'Content-Type': 'application/json',

                            'Accept': 'application/json',

                            'X-CSRF-TOKEN': csrfToken()

                        },

                        body: JSON.stringify(payload)

                    });

                    const data = await res.json();

                    if (res.ok && data.success) {

                        toast(data.message);

                        $('#verifyEmailInput').value = data.email;

                        $('#otpTargetEmail').textContent = data.email;

                        switchTab('verify');

                        startResendCooldown(data.resend_cooldown || 60);

                        $('#verifyOtpInput').value = '';

                        $('#verifyOtpInput').focus();

                    } else if (data.can_retry && data.email) {

                        toast(data.message || 'Verification email delivery failed. Please check your mail settings and request a resend.');

                        $('#verifyEmailInput').value = data.email;

                        $('#otpTargetEmail').textContent = data.email;

                        switchTab('verify');

                    } else {

                        if (data.errors) {

                            Object.entries(data.errors).forEach(([field, msgs]) => {

                                let el = $(`#panelRegister [name="${field}"]`);

                                if (!el && field === 'password') el = $('#regPassword');

                                if (!el && field === 'password_confirmation') el = $('#regConfirmPassword');

                                if (el) setFieldError(el, msgs[0]);

                            });

                        }

                        toast(data.message || 'Registration failed. Please check form inputs.');

                    }

                } catch (err) {

                    toast('Connection error. Please try again.');

                } finally {

                    submitBtn.disabled = false;

                    submitBtn.innerHTML = originalLabel;

                }

            });

        }



        // 3. Verify OTP Form Submit

        const verifyForm = $('#panelVerifyOtp');

        if (verifyForm) {

            verifyForm.addEventListener('submit', async (e) => {

                e.preventDefault();

                const otpInput = $('#verifyOtpInput');

                const errEl = $('#verifyOtpError');

                if (errEl) errEl.textContent = '';

                const otpVal = otpInput.value.trim();

                if (!/^\d{6}$/.test(otpVal)) {

                    if (errEl) errEl.textContent = 'Please enter a valid 6-digit verification code.';

                    otpInput.focus();

                    return;

                }



                const verifyBtn = $('#verifyOtpBtn') || $('button[type="submit"]', e.target);

                const originalLabel = verifyBtn.innerHTML;

                verifyBtn.disabled = true;

                verifyBtn.innerHTML = `<span>Verifying...</span>`;



                const payload = {

                    email: $('#verifyEmailInput').value.trim(),

                    otp: otpVal

                };



                try {

                    const res = await fetch('/verify-otp', {

                        method: 'POST',

                        headers: {

                            'Content-Type': 'application/json',

                            'Accept': 'application/json',

                            'X-CSRF-TOKEN': csrfToken()

                        },

                        body: JSON.stringify(payload)

                    });

                    const data = await res.json();

                    if (res.ok && data.success) {

                        toast(data.message);

                        Modal.close(modal);

                        if (data.user) {

                            updateNavAuth(data.user);

                            document.dispatchEvent(new CustomEvent('auth:login', { detail: data.user }));

                        }

                    } else {

                        if (errEl) errEl.textContent = data.message || 'Invalid verification code.';

                        toast(data.message || 'Verification failed.');

                        otpInput.select();

                    }

                } catch (err) {

                    toast('Connection error during verification.');

                } finally {

                    verifyBtn.disabled = false;

                    verifyBtn.innerHTML = originalLabel;

                }

            });

        }



        // 4. Resend OTP Button Click

        const resendBtn = $('#resendOtpBtn');

        if (resendBtn) {

            resendBtn.addEventListener('click', async () => {

                if (resendBtn.disabled) return;

                const email = $('#verifyEmailInput').value.trim();

                if (!email) return;



                resendBtn.disabled = true;

                resendBtn.textContent = 'Sending...';



                try {

                    const res = await fetch('/resend-otp', {

                        method: 'POST',

                        headers: {

                            'Content-Type': 'application/json',

                            'Accept': 'application/json',

                            'X-CSRF-TOKEN': csrfToken()

                        },

                        body: JSON.stringify({ email })

                    });

                    const data = await res.json();

                    toast(data.message);

                    if (res.ok && data.success) {

                        startResendCooldown(data.resend_cooldown || 60);

                    } else if (data.cooldown_remaining) {

                        startResendCooldown(data.cooldown_remaining);

                    } else {

                        resendBtn.disabled = false;

                        resendBtn.textContent = 'Resend Code';

                    }

                } catch (err) {

                    toast('Failed to resend verification code.');

                    resendBtn.disabled = false;

                    resendBtn.textContent = 'Resend Code';

                }

            });

        }



        const backBtn = $('#backToRegisterBtn');

        if (backBtn) {

            backBtn.addEventListener('click', () => switchTab('register'));

        }



        checkAuthStatus();

        modal.addEventListener('modal:close', () => panels.forEach(clearFormErrors));

    }



    return { init, open, checkAuthStatus, getUser: () => currentUser };

})();



