const FALLBACK_IMG = `data:image/svg+xml;charset=utf-8,${encodeURIComponent(

    '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 300 400"><rect width="300" height="400" fill="#000"/><rect x="14" y="14" width="272" height="372" fill="none" stroke="#DFB043"/><text x="150" y="212" text-anchor="middle" font-family="Georgia,serif" font-size="46" fill="#DFB043">IDFR</text></svg>'

)}`;



document.addEventListener('error', (e) => {

    const img = e.target;

    if (img.tagName === 'IMG' && !img.dataset.fallback) {

        img.dataset.fallback = 'true';

        img.src = FALLBACK_IMG;

    }

}, true);



