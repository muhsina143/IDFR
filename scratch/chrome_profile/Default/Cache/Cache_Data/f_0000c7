function initPreloader() {

    let done = false;

    const finish = () => {

        if (done) return;

        done = true;

        document.body.classList.add('is-loaded');

    };

    if (document.readyState === 'complete') setTimeout(finish, 1000);

    else window.addEventListener('load', () => setTimeout(finish, 1000), { once: true });

    setTimeout(finish, 2600);

}



/* -------------------------------------------------------------------------

   HEADER, MOBILE MENU, SCROLL SPY

   ------------------------------------------------------------------------- */

const MobileMenu = (() => {

    let menu, toggle, isOpen = false;



    function open() {

        if (isOpen) return;

        isOpen = true;

        menu.hidden = false;

        void menu.offsetWidth;

        menu.classList.add('is-open');

        toggle.setAttribute('aria-expanded', 'true');

        toggle.setAttribute('aria-label', 'Close menu');

        lockScroll();

        setTimeout(() => { const a = $('a', menu); if (a) a.focus({ preventScroll: true }); }, 350);

    }



    function close({ restoreFocus = false } = {}) {

        if (!isOpen) return;

        isOpen = false;

        menu.classList.remove('is-open');

        toggle.setAttribute('aria-expanded', 'false');

        toggle.setAttribute('aria-label', 'Open menu');

        unlockScroll();

        setTimeout(() => { if (!isOpen) menu.hidden = true; }, 800);

        if (restoreFocus) toggle.focus({ preventScroll: true });

    }



    function init() {

        menu = $('#mobileMenu');

        toggle = $('.nav__toggle');

        toggle.addEventListener('click', () => (isOpen ? close() : open()));

        $$('a', menu).forEach((a) => a.addEventListener('click', () => close()));



        document.addEventListener('keydown', (e) => {

            if (!isOpen) return;

            if (e.key === 'Escape') { close({ restoreFocus: true }); return; }

            if (e.key === 'Tab') {

                const items = [toggle, ...focusablesIn(menu)];

                const first = items[0];

                const last = items[items.length - 1];

                if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }

                else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }

            }

        });



        window.matchMedia('(min-width: 1025px)').addEventListener('change', (mq) => { if (mq.matches) close(); });

    }



    return { init, open, close, get isOpen() { return isOpen; } };

})();



function initHeader() {

    const header = $('#siteHeader');

    const toTop = $('#toTop');

    let ticking = false;



    const update = () => {

        const y = window.scrollY;

        header.classList.toggle('is-scrolled', y > 40);

        toTop.classList.toggle('is-visible', y > 800);

        ticking = false;

    };

    window.addEventListener('scroll', () => {

        if (!ticking) { requestAnimationFrame(update); ticking = true; }

    }, { passive: true });

    update();



    toTop.addEventListener('click', () => {

        window.scrollTo({ top: 0, behavior: prefersReducedMotion.matches ? 'auto' : 'smooth' });

        const logo = $('.nav__logo');

        if (logo) logo.focus({ preventScroll: true });

    });



    const links = $$('[data-nav]');

    const setActive = (id) => {

        links.forEach((l) => {

            const active = l.dataset.nav === id;

            l.classList.toggle('is-active', active);

            if (active) l.setAttribute('aria-current', 'page'); else l.removeAttribute('aria-current');

        });

    };



    const spy = new IntersectionObserver((entries) => {

        entries.forEach((entry) => { if (entry.isIntersecting) setActive(entry.target.dataset.spy || entry.target.id); });

    }, { rootMargin: '-45% 0px -50% 0px' });

    ['home', 'about', 'models', 'gallery', 'contact'].forEach((id) => {

        const s = document.getElementById(id);

        if (s) spy.observe(s);

    });

    $$('[data-spy]').forEach((s) => spy.observe(s));



    MobileMenu.init();

}



// Desktop navbar dropdown: opens on hover (CSS); the toggle button covers touch and keyboard

function initNavDropdown() {

    $$('.nav__item--drop').forEach((item) => {

        const toggle = $('.nav__drop-toggle', item);

        const links = $$('.nav__dropdown a', item);

        const setOpen = (open) => {

            item.classList.toggle('is-open', open);

            if (open) item.classList.remove('is-dismissed');

            toggle.setAttribute('aria-expanded', String(open));

        };



        toggle.addEventListener('click', () => setOpen(!item.classList.contains('is-open')));

        item.addEventListener('keydown', (e) => {

            const i = links.indexOf(document.activeElement);

            if (e.key === 'Escape' && (item.classList.contains('is-open') || i >= 0)) {

                setOpen(false);

                toggle.focus();

            } else if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {

                if (e.target !== toggle && i < 0) return;

                e.preventDefault();

                setOpen(true);

                const step = e.key === 'ArrowDown' ? 1 : -1;

                links[i < 0 ? (step > 0 ? 0 : links.length - 1) : (i + step + links.length) % links.length].focus();

            } else if ((e.key === 'Home' || e.key === 'End') && i >= 0) {

                e.preventDefault();

                links[e.key === 'Home' ? 0 : links.length - 1].focus();

            }

        });

        item.addEventListener('focusout', (e) => { if (!item.contains(e.relatedTarget)) setOpen(false); });

        document.addEventListener('click', (e) => { if (!item.contains(e.target)) setOpen(false); });

        // After choosing a link the menu stays hidden until the pointer leaves it

        links.forEach((a) => a.addEventListener('click', () => {

            setOpen(false);

            item.classList.add('is-dismissed');

        }));

        item.addEventListener('mouseleave', () => item.classList.remove('is-dismissed'));

    });

}



/* -------------------------------------------------------------------------

   HERO SLIDER

   ------------------------------------------------------------------------- */

function initHero() {

    const hero = $('#home');

    const stage = $('#heroStage');

    const slides = DATA.heroSlides || [];

    const total = slides.length;

    const TRANSITION = 1400;



    const currentEl = $('#heroCurrent');

    const totalEl = $('#heroTotal');

    const bar = $('#heroProgress');

    const previewImg = $('#heroNextImg');

    const previewNum = $('#heroNextNum');

    const caption = $('#heroCaption');

    const prevBtn = $('#heroPrev');

    const nextBtn = $('#heroNextBtn');

    const nextPreviewBtn = $('#heroNextPreview');



    if (totalEl) totalEl.textContent = pad(total);



    if (total === 0) {

        if (stage) stage.innerHTML = '<div class="hero-no-slides" style="display:flex;align-items:center;justify-content:center;height:100%;color:var(--text-muted);font-family:var(--font-sans);letter-spacing:0.1em;text-transform:uppercase;font-size:0.85rem;">No runway images published for this season.</div>';

        if (bar) bar.style.display = 'none';

        if (prevBtn) prevBtn.disabled = true;

        if (nextBtn) nextBtn.disabled = true;

        if (nextPreviewBtn) nextPreviewBtn.style.display = 'none';

        return;

    }



    stage.innerHTML = slides.map((s, i) => `

        <figure class="hero-slide${i === 0 ? ' is-active' : ''}" role="group" aria-roledescription="slide" aria-label="${i + 1} of ${total}: ${esc(s.title)}"${i === 0 ? '' : ' aria-hidden="true"'}>

            <img class="photo" ${i === 0 ? `src="${s.image}" fetchpriority="high"` : `data-src="${s.image}"`} alt="${esc(s.alt)}" width="1100" height="1650" decoding="async">

        </figure>`).join('');



    const els = $$('.hero-slide', stage);

    const ensureSrc = (fig) => {

        if (!fig) return;

        const img = $('img', fig);

        if (img && img.dataset.src) { img.src = img.dataset.src; img.removeAttribute('data-src'); }

    };

    const loadRest = () => els.forEach(ensureSrc);

    if (document.readyState === 'complete') setTimeout(loadRest, 300);

    else window.addEventListener('load', () => setTimeout(loadRest, 300), { once: true });



    let current = 0;

    let busy = false;



    hero.classList.add('is-intro');



    function updateUI() {

        const next = (current + 1) % total;

        const s = slides[current];



        if (currentEl) {

            currentEl.textContent = pad(current + 1);

            currentEl.classList.remove('is-flipping');

            void currentEl.offsetWidth;

            currentEl.classList.add('is-flipping');

        }



        if (previewImg && slides[next]) {

            previewImg.classList.add('is-swapping');

            setTimeout(() => {

                previewImg.src = slides[next].image;

                if (previewNum) previewNum.textContent = pad(next + 1);

                if (nextPreviewBtn) nextPreviewBtn.setAttribute('aria-label', `Show next look: ${slides[next].title}`);

                const reveal = () => previewImg.classList.remove('is-swapping');

                if (previewImg.complete) requestAnimationFrame(reveal); else previewImg.onload = reveal;

            }, 420);

        }



        if (caption) {

            caption.classList.add('is-changing');

            setTimeout(() => {

                const numEl = $('.hero__caption-num', caption);

                const titleEl = $('.hero__caption-title', caption);

                const metaEl = $('.hero__caption-meta', caption);

                if (numEl) numEl.textContent = s.look || `Look ${pad(current + 1)}`;

                if (titleEl) titleEl.textContent = s.title;

                if (metaEl) metaEl.textContent = `Designed by ${s.designer || 'IDFR Runway'}`;

                caption.classList.remove('is-changing');

            }, 450);

        }

    }



    function restartProgress() {

        if (!bar || total <= 1) return;

        bar.classList.remove('run');

        void bar.offsetWidth;

        bar.classList.add('run');

    }



    function goTo(target, dir = 1) {

        if (total <= 1) return;

        const index = (target + total) % total;

        if (busy || index === current) return;

        busy = true;



        const from = els[current];

        const to = els[index];

        ensureSrc(to);

        ensureSrc(els[(index + 1) % total]);



        to.classList.add('no-anim');

        to.classList.remove('is-leaving', 'is-leaving-right', 'from-left');

        if (dir < 0) to.classList.add('from-left');

        void to.offsetWidth;

        to.classList.remove('no-anim', 'from-left');

        to.classList.add('is-active');

        to.removeAttribute('aria-hidden');



        hero.classList.remove('is-intro');

        from.classList.remove('is-active');

        from.classList.add(dir < 0 ? 'is-leaving-right' : 'is-leaving');

        from.setAttribute('aria-hidden', 'true');



        current = index;

        updateUI();

        restartProgress();



        setTimeout(() => {

            from.classList.add('no-anim');

            from.classList.remove('is-leaving', 'is-leaving-right');

            void from.offsetWidth;

            from.classList.remove('no-anim');

            busy = false;

        }, prefersReducedMotion.matches ? 50 : TRANSITION);

    }



    const next = () => goTo(current + 1, 1);

    const prev = () => goTo(current - 1, -1);



    if (total > 1) {

        if (bar) bar.addEventListener('animationend', next);

        if (nextBtn) nextBtn.addEventListener('click', next);

        if (prevBtn) prevBtn.addEventListener('click', prev);

        if (nextPreviewBtn) nextPreviewBtn.addEventListener('click', next);

    } else {

        if (bar) bar.style.display = 'none';

        if (nextPreviewBtn) nextPreviewBtn.style.opacity = '0.5';

    }



    hero.addEventListener('keydown', (e) => {

        if (e.target.closest('input, textarea, select')) return;

        if (e.key === 'ArrowRight') { e.preventDefault(); next(); }

        if (e.key === 'ArrowLeft') { e.preventDefault(); prev(); }

    });



    let touchX = 0;

    let touchY = 0;

    const visual = $('.hero__visual', hero);

    if (visual) {

        visual.addEventListener('touchstart', (e) => {

            touchX = e.changedTouches[0].clientX;

            touchY = e.changedTouches[0].clientY;

        }, { passive: true });

        visual.addEventListener('touchend', (e) => {

            const dx = e.changedTouches[0].clientX - touchX;

            const dy = e.changedTouches[0].clientY - touchY;

            if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.2) (dx < 0 ? next : prev)();

        }, { passive: true });

    }



    // Pausing is driven by animation-play-state on the progress bar

    const reasons = new Set();

    const setPaused = (reason, on) => {

        if (on) reasons.add(reason); else reasons.delete(reason);

        hero.classList.toggle('is-paused', reasons.size > 0);

    };

    [stage, $('#heroNextPreview'), $('.hero__controls')].forEach((el) => {

        el.addEventListener('mouseenter', () => setPaused('hover', true));

        el.addEventListener('mouseleave', () => setPaused('hover', false));

    });

    $('.hero__controls').addEventListener('focusin', () => setPaused('focus', true));

    $('.hero__controls').addEventListener('focusout', () => setPaused('focus', false));

    document.addEventListener('visibilitychange', () => setPaused('hidden', document.hidden));

    new IntersectionObserver(([entry]) => setPaused('offscreen', !entry.isIntersecting), { threshold: 0.15 }).observe(hero);



    restartProgress();

}



