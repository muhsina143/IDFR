'use strict';



/* -------------------------------------------------------------------------

   UTILITIES

   ------------------------------------------------------------------------- */

const $ = (sel, ctx = document) => ctx.querySelector(sel);

const $$ = (sel, ctx = document) => Array.from(ctx.querySelectorAll(sel));

const pad = (n) => String(n).padStart(2, '0');

const esc = (str) => String(str).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));

const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

const canHover = window.matchMedia('(hover: hover)');

const icon = (id) => `<svg class="icon" aria-hidden="true"><use href="#i-${id}"/></svg>`;

const csrfToken = () => $('meta[name="csrf-token"]')?.getAttribute('content') || '';



/* -------------------------------------------------------------------------

   PAGE CONTENT

   Each page keeps the content of its script-built sections in <template> blocks

   under "PAGE CONTENT" near the end of its HTML. They are read once into DATA;

   a section the page doesn't have reads as an empty list.

   ------------------------------------------------------------------------- */

const tplItems = (id) => { const t = document.getElementById(id); return t ? Array.from(t.content.children) : []; };

const textOf = (el, sel) => {

    if (!el) return '';

    const target = sel ? $(sel, el) : el;

    return target?.textContent?.trim() ?? '';

};

const srcOf = (el) => {

    if (!el) return '';

    const img = $(':scope > img', el) || $('img', el);

    return img?.getAttribute('src') || '';

};

const listOf = (el, sel) => (el ? $$(`${sel} > li`, el).map((li) => li.textContent?.trim() || '') : []);

const sizeOf = (img) => [Number(img?.getAttribute('width') || 0), Number(img?.getAttribute('height') || 0)];

const logoOf = (el) => {

    if (!el) return { style: 'circle', mark: 'I', word: 'IDFR' };

    const logoEl = $('[data-logo], [data-src]', el) || el;

    const { logo: style, mark, word, sub, src } = logoEl?.dataset || {};

    if (src) return { src };

    if (!style && !word && !mark) return { style: 'circle', mark: 'I', word: 'IDFR' };

    return sub === undefined ? { style: style || 'circle', mark: mark || '', word: word || '' } : { style: style || 'circle', mark: mark || '', word: word || '', sub };

};



