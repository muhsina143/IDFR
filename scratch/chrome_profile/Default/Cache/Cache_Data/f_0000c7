async function handleModelContact(modelOrId) {

    let model = null;

    if (typeof modelOrId === 'object' && modelOrId !== null) {

        model = modelOrId;

    } else {

        const id = Number(modelOrId);

        model = DATA.models.find((m) => m.id === id);

    }

    if (!model) return;



    try {

        const res = await fetch(`/models/${model.id}/contact-check`, {

            headers: {

                'Accept': 'application/json',

                'X-Requested-With': 'XMLHttpRequest'

            }

        });

        const data = await res.json();



        if (!data.authenticated) {

            // Visitor not logged in: preserve selected model ID and requested Contact action

            sessionStorage.setItem('pendingModelContact', JSON.stringify({

                modelId: model.id,

                modelName: model.name,

                modelLevel: model.level,

                modelLocation: model.location,

                modelPhoto: model.image || model.photo_url

            }));

            toast(`Please log in or register as a Casting Recruiter to contact ${model.name}.`);

            Auth.open('login', 'recruiter');

            return;

        }



        if (!data.can_contact) {

            // Logged in with another role

            toast(data.message || 'Only registered Casting Recruiters are authorized to contact models.');

            return;

        }



        // Authenticated and role is Casting Recruiter!

        openCastingInquiryModal(model, data.user);

    } catch (err) {

        console.error('Contact check error:', err);

        const currentUser = Auth.getUser ? Auth.getUser() : null;

        if (!currentUser) {

            sessionStorage.setItem('pendingModelContact', JSON.stringify({

                modelId: model.id,

                modelName: model.name,

                modelLevel: model.level,

                modelLocation: model.location,

                modelPhoto: model.image

            }));

            Auth.open('login', 'recruiter');

        } else if (currentUser.role === 'recruiter') {

            openCastingInquiryModal(model, currentUser);

        } else {

            toast('Only registered Casting Recruiters are authorized to contact models.');

        }

    }

}



// Preserve Contact Action Across Authentication

document.addEventListener('auth:login', async (e) => {

    const user = e.detail;

    const pendingRaw = sessionStorage.getItem('pendingModelContact');

    if (!pendingRaw) return;



    sessionStorage.removeItem('pendingModelContact');

    let pending;

    try {

        pending = JSON.parse(pendingRaw);

    } catch (_) {

        return;

    }



    if (!pending || !pending.modelId) return;



    if (user && user.role === 'recruiter') {

        const model = DATA.models.find((m) => m.id === Number(pending.modelId)) || {

            id: pending.modelId,

            name: pending.modelName,

            level: pending.modelLevel || 'Runway Model',

            location: pending.modelLocation || 'India',

            image: pending.modelPhoto || ''

        };

        setTimeout(() => {

            openCastingInquiryModal(model, user);

        }, 350);

    } else {

        const roleLabel = user ? (user.role_label || user.role) : 'creative member';

        toast(`Only registered Casting Recruiters are authorized to submit casting inquiries. You are logged in as a ${roleLabel}.`);

    }

});



function initCastingInquiry() {

    const modal = $('#castingInquiryModal');

    const form = $('#castingInquiryForm');

    const formView = $('#castingInquiryFormView');

    const successView = $('#castingInquirySuccessView');

    const submitBtn = $('#castingInquirySubmitBtn');

    if (!form || !modal) return;



    form.addEventListener('submit', async (e) => {

        e.preventDefault();

        clearFormErrors(form);



        const reqSelect = $('#inquiryCastingRequirements');

        if (reqSelect && !reqSelect.value) {

            setFieldError(reqSelect, 'Please select a casting requirement.');

        }



        if (!validateForm(form)) return;



        submitBtn.disabled = true;

        const originalText = submitBtn.innerHTML;

        submitBtn.innerHTML = `<span>Submitting Brief...</span>`;



        try {

            const formData = new FormData(form);

            const token = csrfToken();



            const res = await fetch('/casting-inquiry', {

                method: 'POST',

                headers: {

                    'Accept': 'application/json',

                    'X-Requested-With': 'XMLHttpRequest',

                    'X-CSRF-TOKEN': token

                },

                body: formData

            });



            const data = await res.json().catch(() => null);



            if (res.ok && data?.success) {

                form.reset();

                clearFormErrors(form);

                if (formView) formView.hidden = true;

                if (successView) successView.hidden = false;

                const successText = $('#castingInquirySuccessText');

                if (successText) successText.textContent = data.message;

                toast(data.message || 'Casting inquiry submitted successfully!');

            } else if (res.status === 422 && data?.errors) {

                Object.entries(data.errors).forEach(([field, msgs]) => {

                    const input = form.querySelector(`[name="${field}"]`);

                    if (input) setFieldError(input, msgs[0]);

                });

                const firstMsg = Object.values(data.errors)[0]?.[0] || 'Please correct the errors in the form.';

                toast(firstMsg);

            } else {

                toast(data?.message || 'Failed to submit casting inquiry. Please check your submission.');

            }

        } catch (err) {

            console.error('Casting inquiry submission error:', err);

            toast('Connection error. Please try again.');

        } finally {

            submitBtn.disabled = false;

            submitBtn.innerHTML = originalText;

        }

    });



    modal.addEventListener('modal:close', () => {

        clearFormErrors(form);

        if (formView) formView.hidden = false;

        if (successView) successView.hidden = true;

    });

}



