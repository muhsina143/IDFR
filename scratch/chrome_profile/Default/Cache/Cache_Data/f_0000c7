const Auth = (() => {

    let modal, tabs, panels;

    let cooldownTimer = null;



    function setFieldError(input, msg) {

        if (!input) return;

        const field = input.closest('.field') || input.parentElement;

        field.classList.toggle('has-error', Boolean(msg));

        input.setAttribute('aria-invalid', msg ? 'true' : 'false');

        const errEl = $('.field__error', field);

        if (errEl) errEl.textContent = msg || '';

    }



    function clearFormErrors(form) {

        if (!form) return;

        $$('.field.has-error', form).forEach((f) => f.classList.remove('has-error'));

        $$('.field__error', form).forEach((e) => { e.textContent = ''; });

        $$('[aria-invalid]', form).forEach((el) => el.removeAttribute('aria-invalid'));

    }



    function startResendCooldown(seconds = 60) {

        const btn = $('#resendOtpBtn');

        if (!btn) return;

        clearInterval(cooldownTimer);

        let remaining = seconds;

        btn.disabled = true;

        btn.textContent = `Resend Code (${remaining}s)`;

        cooldownTimer = setInterval(() => {

            remaining--;

            if (remaining <= 0) {

                clearInterval(cooldownTimer);

                btn.disabled = false;

                btn.textContent = 'Resend Code';

            } else {

                btn.textContent = `Resend Code (${remaining}s)`;

            }

        }, 1000);

    }



    function switchTab(name, focus = false) {

        tabs.forEach((t) => {

            const on = t.dataset.tab === name;

            t.classList.toggle('is-active', on);

            t.setAttribute('aria-selected', String(on));

            t.tabIndex = on ? 0 : -1;

            if (on && focus) t.focus();

        });



        panels.forEach((p) => {

            if (name === 'login') p.hidden = p.id !== 'panelLogin';

            else if (name === 'register') p.hidden = p.id !== 'panelRegister';

            else if (name === 'verify') p.hidden = p.id !== 'panelVerifyOtp';

        });



        if (name === 'login') $('#authTitle').textContent = 'Welcome back';

        else if (name === 'register') $('#authTitle').textContent = 'Join IDFR';

        else if (name === 'verify') $('#authTitle').textContent = 'Verify Email';

    }



    function open(tab = 'login', role, trigger) {

        const user = currentUser || (typeof window !== 'undefined' ? window.__IDFR_USER__ : null);

        if (user && user.id) {

