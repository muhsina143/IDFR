// Splits tiles of the given heights into n columns of item indexes for a bento (masonry) grid.

// Shortest-column placement keeps the reading order; a few passes of moving or swapping tiles

// between columns then even out the column ends

function balanceColumns(heights, n) {

    const columns = Array.from({ length: n }, () => []);

    let hs = new Array(n).fill(0);

    heights.forEach((h, i) => {

        const c = hs.indexOf(Math.min(...hs));

        columns[c].push(i);

        hs[c] += h;

    });

    const spreadWith = (a, da, b, db) => {

        const t = hs.map((h, c) => h + (c === a ? da : c === b ? db : 0));

        return Math.max(...t) - Math.min(...t);

    };

    for (let pass = 0; pass < 20; pass++) {

        let best = spreadWith() - 0.01;

        let change = null;

        for (let a = 0; a < n; a++) for (let b = 0; b < n; b++) {

            if (a === b) continue;

            columns[a].forEach((ia, ka) => {

                const ta = heights[ia];

                if (columns[a].length > 1) {

                    const s = spreadWith(a, -ta, b, ta);

                    if (s < best) { best = s; change = { a, ka, b, kb: -1 }; }

                }

                columns[b].forEach((ib, kb) => {

                    const d = heights[ib] - ta;

                    const s = spreadWith(a, d, b, -d);

                    if (s < best) { best = s; change = { a, ka, b, kb }; }

                });

            });

        }

        if (!change) break;

        const { a, ka, b, kb } = change;

        if (kb < 0) columns[b].push(...columns[a].splice(ka, 1));

        else[columns[a][ka], columns[b][kb]] = [columns[b][kb], columns[a][ka]];

        hs = columns.map((c) => c.reduce((sum, i) => sum + heights[i], 0));

    }

    return columns;

}



/* Shared image viewer. Items: { image, title, season (label), alt } */

const Lightbox = (() => {

    let lb, img, list = [], index = 0, swapTimer, ready = false;



    const apply = () => {

        const g = list[index];

        img.src = g.image;

        img.alt = g.alt || g.title;

        $('#lightboxSeason').textContent = g.season;

        $('#lightboxCaption').textContent = g.title;

        $('#lightboxCounter').textContent = `${pad(index + 1)} / ${pad(list.length)}`;

        [list[(index + 1) % list.length], list[(index - 1 + list.length) % list.length]].forEach((n) => { new Image().src = n.image; });

    };



    const show = (dir) => {

        clearTimeout(swapTimer);

        img.classList.add(dir > 0 ? 'is-out-left' : 'is-out-right');

        swapTimer = setTimeout(() => {

            apply();

            img.classList.remove('is-out-left', 'is-out-right');

            img.classList.add(dir > 0 ? 'is-out-right' : 'is-out-left');

            const reveal = () => requestAnimationFrame(() => img.classList.remove('is-out-left', 'is-out-right'));

            if (img.complete) reveal(); else { img.onload = reveal; img.onerror = reveal; }

        }, 280);

    };



    const step = (dir) => {

        index = (index + dir + list.length) % list.length;

        show(dir);

    };



    function init() {

        if (ready) return;

        ready = true;

        lb = $('#lightbox');

        img = $('#lightboxImg');

        $('#lightboxPrev').addEventListener('click', () => step(-1));

        $('#lightboxNext').addEventListener('click', () => step(1));

        lb.addEventListener('click', (e) => {

            if (e.target === lb || e.target.classList.contains('lightbox__figure')) Modal.close(lb);

        });

        document.addEventListener('keydown', (e) => {

            if (Modal.top() !== lb) return;

            if (e.key === 'ArrowRight') step(1);

            if (e.key === 'ArrowLeft') step(-1);

        });

        let sx = 0;

        lb.addEventListener('touchstart', (e) => { sx = e.changedTouches[0].clientX; }, { passive: true });

        lb.addEventListener('touchend', (e) => {

            const dx = e.changedTouches[0].clientX - sx;

            if (Math.abs(dx) > 50) step(dx < 0 ? 1 : -1);

        }, { passive: true });

    }



    function open(items, start, trigger) {

        init();

        list = items;

        index = start;

        img.classList.remove('is-out-left', 'is-out-right');

        apply();

        Modal.open(lb, trigger);

    }



    return { open };

})();



function initGallery() {

