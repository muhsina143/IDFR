    <!-- Model profile modal: booking enquiry form ("Contact / Enquire"). The heading becomes "Book <first name>". -->
    <template id="modelEnquiryTemplate">
      <button class="enquiry__back" type="button" data-enquiry-back>
        <svg class="icon" aria-hidden="true"><use href="#i-arrow-left" /></svg>
        Back to profile
      </button>
      <p class="mm__label" style="margin-top: 1.25rem">Booking Enquiry</p>
      <h2 class="mm__name" id="modelModalName">Book</h2>
      <form class="enquiry" id="enquiryForm" novalidate>
        <div class="field-row">
          <div class="field">
            <label for="enqName">Your name</label>
            <input
              id="enqName"
              name="name"
              type="text"
              autocomplete="name"
              required
              minlength="2"
              placeholder="Full name"
            />
            <span class="field__error" aria-live="polite"></span>
          </div>
          <div class="field">
            <label for="enqEmail">Email</label>
            <input
              id="enqEmail"
              name="email"
              type="email"
              autocomplete="email"
              required
              placeholder="you@company.com"
            />
            <span class="field__error" aria-live="polite"></span>
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="enqType">Assignment type</label>
            <select id="enqType" name="type">
              <option>Runway Show</option>
              <option>Editorial Shoot</option>
              <option>Commercial / Ad Film</option>
              <option>Brand Campaign</option>
              <option>Other</option>
            </select>
          </div>
          <div class="field">
            <label for="enqDate">Preferred date</label>
            <input id="enqDate" name="date" type="date" />
          </div>
        </div>
        <div class="field">
          <label for="enqMsg">Brief</label>
          <textarea
            id="enqMsg"
            name="message"
            required
            minlength="10"
            placeholder="Tell us about the assignment, location and budget"
          ></textarea>
          <span class="field__error" aria-live="polite"></span>
        </div>
        <button class="btn btn--gold btn--block" type="submit">
          <span>Send Enquiry</span
          ><svg class="icon" aria-hidden="true">
            <use href="#i-arrow-right" />
          </svg>
        </button>
      </form>
    </template>

